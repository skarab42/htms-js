{
  "name": "htms-js",
  "description": "HTMS 💨 Stream Async HTML, Stay SEO-Friendly",
  "version": "0.4.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": {
    "name": "skarab42",
    "email": "skarab@bluewin.ch"
  },
  "funding": "https://github.com/sponsors/skarab42",
  "homepage": "https://github.com/skarab42/htms-js",
  "repository": "https://github.com/skarab42/htms-js",
  "bugs": "https://github.com/skarab42/htms-js/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf ./dist",
    "build:ts": "tsc -p tsconfig.build.json",
    "build:js": "tsc -p ./src/browser/tsconfig.build.json",
    "minify": "terser ./dist/browser/api.js -o ./dist/browser/api.min.js --compress --mangle",
    "build": "pnpm clean && pnpm build:js && pnpm build:ts && pnpm minify",
    "build:check": "tsc -p ./tsconfig.json",
    "build:watch": "pnpm build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "entities": "^7.0.0",
    "json5": "^2.2.3",
    "parse5-html-rewriting-stream": "^8.0.0"
  },
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": "22.x || 24.x"
  },
  "keywords": [
    "stream",
    "async",
    "html",
    "seo"
  ],
  "devDependencies": {
    "terser": "^5.44.0"
  }
}
