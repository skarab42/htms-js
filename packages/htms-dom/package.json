{
  "name": "htms-dom",
  "description": "HTMS 💨 Stream Async HTML, Stay SEO-Friendly",
  "version": "1.0.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": {
    "name": "skarab42",
    "email": "skarab@bluewin.ch"
  },
  "funding": "https://github.com/sponsors/skarab42",
  "homepage": "https://github.com/skarab42/htms-js",
  "repository": "https://github.com/skarab42/htms-js",
  "bugs": "https://github.com/skarab42/htms-js/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/umd/index.js",
  "jsdelivr": "./dist/umd/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "browser": "./dist/umd/index.js",
      "default": "./dist/index.js"
    },
    "./commit-mode": {
      "types": "./dist/commit-mode.d.ts",
      "import": "./dist/commit-mode.js",
      "default": "./dist/commit-mode.js"
    },
    "./umd": {
      "import": "./dist/umd/index.js",
      "default": "./dist/umd/index.js"
    },
    "./umd-min": {
      "import": "./dist/umd/index.min.js",
      "default": "./dist/umd/index.min.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf ./dist",
    "build:umd": "node ./build-umd.mjs",
    "build:ts": "tsc -p ./tsconfig.build.json",
    "build": "pnpm clean && pnpm build:umd && pnpm build:ts",
    "build:check": "tsc -p ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  },
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": "22.x || 24.x"
  },
  "keywords": [
    "stream",
    "async",
    "html",
    "seo",
    "dom"
  ]
}
