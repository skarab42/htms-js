{
  "name": "fastify-htms",
  "description": "HTMS 💨 Stream Async HTML, Stay SEO-Friendly",
  "version": "0.4.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": {
    "name": "skarab42",
    "email": "skarab@bluewin.ch"
  },
  "funding": "https://github.com/sponsors/skarab42",
  "homepage": "https://github.com/skarab42/htms-js",
  "repository": "https://github.com/skarab42/htms-js",
  "bugs": "https://github.com/skarab42/htms-js/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf ./dist",
    "build": "pnpm clean && tsc -p ./tsconfig.build.json",
    "build:check": "tsc -p ./tsconfig.json",
    "build:watch": "pnpm build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "fastify-plugin": "^5.0.1",
    "htms-js": "workspace:*",
    "minimatch": "^10.0.3"
  },
  "devDependencies": {
    "fastify": "^5.6.0"
  },
  "peerDependencies": {
    "fastify": ">=5"
  },
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": "22.x || 24.x"
  },
  "keywords": [
    "fastify",
    "stream",
    "async",
    "html",
    "seo"
  ]
}
