{
  "private": true,
  "name": "htms-js-woprkspace",
  "type": "module",
  "scripts": {
    "prepare": "npx simple-git-hooks",
    "lint": "eslint .",
    "lint:fix": "pnpm lint --fix",
    "lint:check": "pnpm lint --max-warnings=0",
    "format": "prettier **/* --ignore-unknown",
    "format:write": "pnpm format --write",
    "format:check": "pnpm format --check",
    "test": "pnpm -r test",
    "test:watch": "pnpm vitest",
    "coverage": "pnpm -r coverage",
    "build": "pnpm -r build",
    "build:check": "pnpm -r build:check",
    "check": "pnpm format:check && pnpm lint:check && pnpm build:check && pnpm test",
    "reset": "rimraf --glob ./pnpm-lock.yaml **/node_modules **/dist **/coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@skarab/prettier-config": "^1.2.2",
    "@types/node": "^24.5.1",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "^9.35.0",
    "eslint-config-flat-gitignore": "^2.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unicorn": "^61.0.2",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  },
  "prettier": "@skarab/prettier-config",
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": [
      "pnpm prettier --write --ignore-unknown",
      "pnpm eslint --fix --no-warn-ignored --max-warnings=0"
    ]
  },
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": "22.x || 24.x"
  }
}
